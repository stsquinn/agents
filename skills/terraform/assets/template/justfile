# Terraform helpers. Run `just` to list them.
#
# Stack is a directory: shared, envs/stg, envs/prod.
# Locally, `export AWS_PROFILE=__AWS_PROFILE__` first. CI authenticates via OIDC and
# must not have a profile set, so nothing here sets one.

stacks := "shared envs/stg envs/prod"

default:
    @just --list --unsorted

# terraform init  (just init envs/stg)
init stack *args:
    terraform -chdir={{ stack }} init -input=false {{ args }}

# terraform plan  (just plan envs/prod)
plan stack *args:
    terraform -chdir={{ stack }} plan -input=false {{ args }}

# terraform plan under the readonly role, which cannot take the state lock
plan-ro stack:
    terraform -chdir={{ stack }} plan -input=false -lock=false

# terraform apply  (prefer the workflow_dispatch pipeline for anything deployed)
apply stack *args:
    terraform -chdir={{ stack }} apply -input=false {{ args }}

# terraform output  (just output shared)
output stack:
    terraform -chdir={{ stack }} output

# Everything CI checks
check: fmt-check validate

fmt:
    terraform fmt -recursive

fmt-check:
    terraform fmt -check -recursive -diff

# Validate every stack and module without touching remote state
validate:
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob  # a repo may have no modules yet
    for dir in {{ stacks }} modules/*/; do
      echo "==> ${dir%/}"
      terraform -chdir="$dir" init -backend=false -input=false > /dev/null
      terraform -chdir="$dir" validate
    done

lint:
    tflint --recursive

# Read-only sweep of the live account -> .inventory/ with import scaffolding
inventory *args:
    ./scripts/aws-inventory.sh {{ args }}

# First run only: creates the state bucket
bootstrap:
    #!/usr/bin/env bash
    set -euo pipefail
    terraform -chdir=shared init -input=false
    terraform -chdir=shared apply -input=false
    echo
    echo "Next: uncomment the backend block in shared/versions.tf, then run"
    echo "  just migrate-state"

# Move shared/ state off the laptop into the bucket it just created
migrate-state:
    terraform -chdir=shared init -migrate-state

# Remove every local .terraform directory
clean:
    find . -type d -name .terraform -prune -exec rm -rf {} +
